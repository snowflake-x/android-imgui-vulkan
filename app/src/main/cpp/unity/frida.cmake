set(FRIDA_VERSION 17.2.17)
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(FRIDA_ARCH arm64)
    set(FRIDA_CORE_SHA 1eeeed92c1abf59e2a968030007e81eb8192acb9924a48fe7f9e7f5994bc9b90)
    set(FRIDA_GUM_SHA e0a868eded184677bd71d4f98fdfdc8c7590bb4aa03ccd1acb72bd02a927db2e)
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(FRIDA_ARCH x86_64)
    set(FRIDA_CORE_SHA 890bc0f2306238aeaee902d8249a18480a55c61f59b332be46fa97617093a772)
    set(FRIDA_GUM_SHA 54e090b076a978279896959d6783a8e45616b98ffd6e56491ce02d9cb8b2225c)
else()
    message(FATAL_ERROR "Unity inspector supports arm64-v8a and x86_64")
endif()
get_filename_component(FRIDA_CACHE "${CMAKE_CURRENT_LIST_DIR}/../../../../../.deps/frida/${FRIDA_VERSION}" ABSOLUTE)
foreach(kind core gum)
    set(dir "${FRIDA_CACHE}/${kind}-${FRIDA_ARCH}")
    if(NOT EXISTS "${dir}/libfrida-${kind}.a")
        file(MAKE_DIRECTORY "${dir}")
        string(TOUPPER "${kind}" KIND)
        file(DOWNLOAD "https://github.com/frida/frida/releases/download/${FRIDA_VERSION}/frida-${kind}-devkit-${FRIDA_VERSION}-android-${FRIDA_ARCH}.tar.xz"
            "${dir}/devkit.tar.xz" EXPECTED_HASH "SHA256=${FRIDA_${KIND}_SHA}" TLS_VERIFY ON)
        file(ARCHIVE_EXTRACT INPUT "${dir}/devkit.tar.xz" DESTINATION "${dir}")
    endif()
    add_library(frida_${kind} STATIC IMPORTED)
    set_target_properties(frida_${kind} PROPERTIES IMPORTED_LOCATION "${dir}/libfrida-${kind}.a" INTERFACE_INCLUDE_DIRECTORIES "${dir}")
endforeach()
include(${CMAKE_CURRENT_LIST_DIR}/ffi.cmake)
add_library(vulkanscope_unity SHARED unity/agent.cpp unity/runtime.cpp unity/ffi_hook.cpp)
target_include_directories(vulkanscope_unity PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${FFI_HEADERS})
target_link_libraries(vulkanscope_unity PRIVATE frida_gum log dl)
add_library(vulkanscope_injector SHARED unity/injector.cpp memory/scan.cpp)
target_include_directories(vulkanscope_injector PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(vulkanscope_injector PRIVATE frida_core log dl)
foreach(target vulkanscope_unity vulkanscope_injector)
    target_link_options(${target} PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL")
endforeach()
