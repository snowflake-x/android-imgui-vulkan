set(VERSION 3.4.4)
set(HAVE_LONG_DOUBLE 1)
set(FFI_EXEC_TRAMPOLINE_TABLE 0)
if(ANDROID_ABI STREQUAL "arm64-v8a" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
    set(TARGET AARCH64)
    set(FFI_TARGET_HEADER aarch64-ffitarget.h)
else()
    set(TARGET X86_64)
    set(FFI_TARGET_HEADER x86_64-ffitarget.h)
endif()
set(FFI_HEADERS "${CMAKE_CURRENT_BINARY_DIR}/unity-ffi")
configure_file("${CMAKE_CURRENT_LIST_DIR}/../vendor/libffi/ffi.h.in" "${FFI_HEADERS}/ffi.h" @ONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../vendor/libffi/${FFI_TARGET_HEADER}" "${FFI_HEADERS}/ffitarget.h" COPYONLY)
